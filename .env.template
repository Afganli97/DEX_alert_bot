# DEX Alert Bot Environment Configuration
# Copy this file to .env and fill in your values

# Telegram Bot API Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# MongoDB URI (local or cloud)
MONGO_URI=mongodb://localhost:27017/dexalerts

# Admin chat IDs (comma-separated list)
ADMIN_CHAT_IDS=

# Optional: Override cycle intervals (in milliseconds)
# CYCLE_INTERVAL_MS=20000
# BATCH_DELAY_MS=1000

# Webhook URL (full URL that Telegram will call, e.g. https://bot.example.com/webhook)
WEBHOOK_URL=
